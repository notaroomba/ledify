{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

# Same as Caddyfile, plus a login for everything except the firmware image (the board fetches that without credentials).
:{$PORT:3000} {
	root * /srv
	encode gzip
	@protected not path /firmware/*
	basic_auth @protected {
		{$PANEL_USER} {$PANEL_HASH}
	}
	@fresh path / /index.html /config.js /firmware/* /sw.js
	header @fresh Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	file_server
}
