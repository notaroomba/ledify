CONFIG_IDF_TARGET="esp32c6"

# Bluetooth: NimBLE peripheral only
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# W25Q128 is 16 MB; two 4 MB app slots for OTA (Wi-Fi + TLS + BLE is about 1.6 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Console on the built-in USB port. UART0 TX is GPIO16, which is the FUSB302 interrupt line.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_FREERTOS_HZ=1000

# OTA: two 4 MB app slots, the new image must call ota_mark_ok() or the bootloader rolls back; plain http:// allowed
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
